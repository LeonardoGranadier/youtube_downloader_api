# Caminho do FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# Número máximo de downloads simultâneos
MAX_CONCURRENT_DOWNLOADS=2

# Ambiente
ENVIRONMENT=development

# Prefixo da API
API_PREFIX=/api/v1

# Chave de autenticação da API
# Gere uma chave segura para cada ambiente.
MEDIA_API_KEY=SUBSTITUA_POR_UMA_CHAVE_SEGURA
# Limites por download
MAX_DURATION_SECONDS=1800
MAX_FILESIZE_MB=500

# Arquivos prontos ficam disponíveis por este tempo e depois são apagados
FILE_TTL_MINUTES=60
CLEANUP_INTERVAL_SECONDS=300
